{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.claude",
      "!brand",
      "!site",
      "!website",
      "!docs-site",
      "!**/drizzle",
      "!**/.next",
      "!**/dist",
      "!**/node_modules",
      "!**/globals.css",
      "!**/parity-tools",
      "!docs/parity-baselines",
      "!**/.dsh",
      "!scripts/check-progress.mjs",
      "!.e2e",
      "!e2e/screenshots",
      "!test-results",
      "!playwright-report",
      "!.smoke",
      "!.mail-capture",
      "!.push-capture",
      "!public/sw.js",
      "!DEALFLOW",
      "!PLAN AND EXECUTE",
      "!docs/dealflow/mail-probe-result.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
