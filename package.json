{
  "name": "dealflow",
  "version": "1.2.0",
  "description": "Dealflow: a self-hosted CRM for business development, built on warpdrive.",
  "main": "index.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:sw && ALLOW_FIRST_LOGIN_ADMIN=false next build",
    "build:sw": "node scripts/dealflow/build-sw.mjs",
    "build:workers": "node scripts/build-workers.mjs",
    "build:docker": "pnpm build:sw && next build && node scripts/build-workers.mjs",
    "push:vapid": "node scripts/dealflow/push-vapid.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "TZ=UTC LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 vitest run --project unit",
    "test:integration": "TZ=UTC LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 vitest run --project integration",
    "test:watch": "vitest",
    "lint": "biome check . && eslint . --no-warn-ignored",
    "lint:fix": "biome check --write . && eslint . --fix --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "api:docs": "tsx scripts/dealflow/api-docs.ts",
    "backup:restore": "tsx scripts/dealflow/backup-restore.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:smoke": "tsx --env-file .env scripts/seed-smoke.ts",
    "db:seed:smoke:phase5": "tsx --env-file .env scripts/seed-smoke-phase5.ts",
    "db:seed:demo": "tsx --env-file .env scripts/seed-demo.ts",
    "email:sweep-spam": "tsx --env-file .env src/entrypoints/sweepSpam.ts",
    "check:design": "node scripts/dealflow/check-design.mjs",
    "env:sync": "node scripts/dealflow/env-sync.mjs",
    "dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres minio createbuckets",
    "db:migrate:dev": "tsx --env-file=.env src/entrypoints/migrate.ts",
    "mail:probe": "tsx scripts/dealflow/mail-probe.ts",
    "mail:live-check": "tsx scripts/dealflow/mail-live-check.ts",
    "ai:check-model": "tsx scripts/dealflow/check-model.ts",
    "auth:bootstrap-link": "tsx --env-file=.env scripts/dealflow/bootstrap-link.ts",
    "e2e:build": "pnpm build:sw && node scripts/e2e/build.mjs",
    "e2e": "pnpm e2e:build && playwright test",
    "smoke": "node scripts/dealflow/smoke.mjs",
    "docs:pdf": "node scripts/dealflow/build-user-guide-pdf.mjs",
    "docs:screenshots": "node scripts/dealflow/capture-user-guide.mjs",
    "site:build": "node scripts/dealflow/build-site.mjs",
    "email:gallery": "GOOGLE_OAUTH_CLIENT_ID= GOOGLE_OAUTH_CLIENT_SECRET= GOOGLE_WORKSPACE_DOMAIN= tsx --env-file=.env scripts/dealflow/email-gallery.mts"
  },
  "keywords": [],
  "author": "Nikita Sawinyh",
  "contributors": [
    "Dealflow contributors"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-font-family": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@trpc/client": "^11.25.2",
    "@trpc/react-query": "^11.25.2",
    "@trpc/server": "^11.25.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "imapflow": "2.11.0",
    "isomorphic-dompurify": "^4.7.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "mailparser": "3.14.2",
    "marked": "^18.1.3",
    "mcp-handler": "^2.3.1",
    "minio": "^8.0.7",
    "next": "^16.4.5",
    "nodemailer": "10.4.0",
    "openai": "7.53.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "posthog-js": "^1.447.3",
    "posthog-node": "^5.63.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "web-push": "4.0.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "^29.1.1",
    "pdf-lib": "1.17.1",
    "postcss": "^8.5.16",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
