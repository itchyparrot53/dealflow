# Reverse proxy example (only for docs/reverse-proxy/Caddyfile.example). The default Docker
# stack has no proxy; these values are read by Caddy when you run the documented example, not by
# the app. APP_DOMAIN is the public hostname you point DNS at; ACME_EMAIL receives certificate
# expiry notices.
APP_DOMAIN=
ACME_EMAIL=

# Auth / Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
# Public base URL. In production this MUST be https://<APP_DOMAIN> (Google OAuth will not
# redirect to a bare IP, and cookies are set Secure).
BASE_URL=

# Sign-in
# Email + password and email-link sign-in are on by default. Google appears only when all three
# GOOGLE_* values above are set together; leave all three empty to switch Google off.
AUTH_PASSWORD_ENABLED=true
AUTH_MAGIC_LINK_ENABLED=true

# System mail
# Magic links, invites and the first-admin setup link. An empty SMTP_HOST prints the links to the
# server log instead of sending them, which is the local default; set a real host for production.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dealflow <no-reply@localhost>"
# MAIL_FAKE=true writes system mail to MAIL_CAPTURE_DIR as JSON instead of sending it. Tests and the
# e2e stack use it; it is allowed in production because the captured mail never leaves the box.
MAIL_FAKE=false
MAIL_CAPTURE_DIR=.mail-capture

# Part 14: the install-wide daily cap on marketing double opt-in emails.
CAMPAIGN_DOI_DAILY_LIMIT=500

# Mail (IMAP/SMTP)
# Connected mailboxes sync over IMAP and send over SMTP. Set MAIL_PROVIDER_FAKE_DIR to a folder to
# use the filesystem fake transport instead of a real server (tests and e2e do this); leave it empty
# for real mail.
MAIL_PROVIDER_FAKE_DIR=
# First sync covers this many days; the background backfill walks back to MAIL_BACKFILL_DAYS.
MAIL_INITIAL_SYNC_DAYS=90
MAIL_BACKFILL_DAYS=365
# Poll every folder on this cadence, and keep at most this many live IDLE connections.
MAIL_SYNC_CADENCE_SECONDS=90
MAIL_IDLE_MAX=50
# Messages larger than this store headers plus a placeholder body instead of the full source.
MAIL_MAX_MESSAGE_BYTES=15728640
# Outbound limits: recipients per rolling 24 hours, and per message.
MAIL_SEND_DAILY_RECIPIENTS=2800
MAIL_SEND_MAX_RECIPIENTS=250

# Database
DATABASE_URL=

# Realtime
WS_TICKET_SECRET=
# Server-side WS URL (worker/relay). On the box this is the internal address: ws://ws:8080
WS_PUBLIC_URL=
# Browser-facing WS URL. MUST be set (NEXT_PUBLIC_* is inlined at build time) or
# the client silently gets no realtime (board, inbox, notifications, presence).
# Production (proxy on the same domain): wss://<APP_DOMAIN>/_ws
NEXT_PUBLIC_WS_URL=

# Install, offline and push mentions in the UI. Off by default; the e2e build turns it on.
NEXT_PUBLIC_PWA_UI=false

# Storage (MinIO)
# Full URL, browser-reachable. The browser POSTs presigned uploads directly here, so in a single-box
# deploy this is the public https://s3.<domain> vhost, NOT the internal "minio" alias. Local dev:
# http://localhost:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=warpdrive
MAX_FILE_BYTES=26214400

# Docker host ports
# The base compose publishes app, ws and the MinIO S3 API on 127.0.0.1 so a proxy on this box can
# reach them. Set a bind to 0.0.0.0 (or a LAN address) only when the proxy runs on another machine,
# and firewall those ports: the app trusts the proxy's X-Forwarded-For for rate limiting.
APP_BIND=127.0.0.1
APP_PORT=3000
WS_BIND=127.0.0.1
WS_HOST_PORT=8080
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
# Debug ports added by docker-compose.dev.yml.
DEV_PG_PORT=5433
MINIO_CONSOLE_PORT=9001
# Compose file the services read for env_file. Override it for the smoke test or a second stack.
DEALFLOW_ENV_FILE=.env
# The official MinIO images were withdrawn from Docker Hub and quay.io. These empty values keep the
# compose defaults (pgsty/minio and pgsty/mc); set either to another S3-compatible server/client.
MINIO_IMAGE=
MC_IMAGE=

# AI (OpenRouter)
# Leave the key empty to keep the AI features unavailable. OPENROUTER_MODEL defaults to the live
# DeepSeek Flash alias; append the date to pin a snapshot, for example
# deepseek/deepseek-v4.1-flash-1017. AI_FAKE=true gives deterministic answers for tests and demos.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
AI_FAKE=false

# Secrets
TOKEN_ENCRYPTION_KEY=

# MCP server (AI assistant integration)
# MCP_ENABLED gates the whole MCP plus OAuth surface. OAUTH_SIGNING_KEY signs access-token JWTs;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MCP_ENABLED=true
OAUTH_SIGNING_KEY=
# OAUTH_REGISTRATION controls RFC 7591 dynamic client registration: "open" (default) lets an MCP
# client self-onboard by POSTing to /oauth/register with no credential, which is what makes
# "just add the server URL" work in Claude Desktop and friends. The cost is that any stranger can
# create a client and choose the name your users read on the consent screen. Once you have
# connected the clients you need, set this to "disabled": existing grants keep working, and the
# registration endpoint 404s and stops being advertised in discovery metadata.
OAUTH_REGISTRATION=open

# Business
BASE_CURRENCY=USD
SEED_ADMIN_EMAIL=
ALLOW_FIRST_LOGIN_ADMIN=false

# Update check (upstream releases)
# OFF by default on purpose. Set DISABLE_UPDATE_CHECK=false to opt in to the admin banner and the
# worker poll of the upstream GitHub releases. APP_VERSION: the running version shown as "current".
# Usually stamped at build (release tag); leave empty to fall back to package.json, then "dev"
# (which disables the banner).
APP_VERSION=
DISABLE_UPDATE_CHECK=true

# Automations and webhooks
# TRUSTED_PROXY_HOPS: how many reverse proxies append to X-Forwarded-For. The client IP used for
# public rate limits is read that many places from the right, so leave 1 behind one proxy and set
# 0 only when the app is directly exposed (then X-Real-IP is used).
TRUSTED_PROXY_HOPS=1
# OFF by default: webhook targets must be public addresses. Setting true removes the private,
# loopback and link-local block and is only meant for local receivers and the e2e suite.
WEBHOOK_ALLOW_PRIVATE=false

# Observability (PostHog, optional)
# POSTHOG_KEY is a project ingestion token that posthog-js ships to browsers, and POSTHOG_HOST is a
# public URL, so neither is secret. In a production deploy they are typically set in your tracked
# compose file, not here. Set them in this .env for local dev or a self-hoster not using a separate
# compose. Leaving POSTHOG_KEY or POSTHOG_HOST empty disables all telemetry (browser + server).
POSTHOG_HOST=
POSTHOG_KEY=
# OFF by default on purpose. Set DISABLE_TELEMETRY=false to opt in to capture when the keys are set.
DISABLE_TELEMETRY=true

# Mail probe (owner only)
# Used by `pnpm mail:probe` to record what the real IMAP/SMTP host supports. Leave the user and
# password empty to write a skipped result. The app never reads these values.
MAIL_PROBE_USER=
MAIL_PROBE_PASS=
MAIL_PROBE_IMAP_HOST=imap.purelymail.com
MAIL_PROBE_IMAP_PORT=993
MAIL_PROBE_SMTP_HOST=smtp.purelymail.com
MAIL_PROBE_SMTP_PORT=465
MAIL_PROBE_TO=

# Backups
# A daily job writes a pg_dump custom-format archive plus the storage files to BACKUP_DIR, keeping
# the newest BACKUP_KEEP archives. The worker writes them and the app mounts the same volume
# read-only so admins can download. PG_DUMP_PATH and PG_RESTORE_PATH name the client binaries (the
# runtime image ships postgresql16-client to match the Postgres 16 server).
BACKUP_DIR=/var/lib/dealflow/backups
BACKUP_KEEP=7
BACKUP_ENABLED=true
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Web push (optional)
# Users can enable push per device and choose which notification types are pushed. Push is off
# until all three VAPID values are set together; leaving them empty makes the settings page say
# "Not set up on this server". Generate a pair with `pnpm push:vapid` and paste it here (the
# script only prints it, it never writes this file). VAPID_SUBJECT is a mailto: or https: contact
# URL the push service can use, for example mailto:ops@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# PUSH_FAKE=true writes each delivery to PUSH_FAKE_DIR as JSON instead of sending it. Tests and the
# e2e stack use it; like MAIL_FAKE the files never leave the box.
PUSH_FAKE=false
PUSH_FAKE_DIR=.push-capture

# Part 14: campaign sending. Leave MARKETING_SMTP_HOST empty to send through the system SMTP.
MARKETING_SMTP_HOST=
MARKETING_SMTP_PORT=465
MARKETING_SMTP_SECURE=true
MARKETING_SMTP_USER=
MARKETING_SMTP_PASS=
CAMPAIGN_SEND_RATE_PER_MINUTE=60
CAMPAIGN_BATCH_SIZE=50

# Part 14: optional DKIM signing. Set domain, selector and one of the key fields to enable it.
CAMPAIGN_DKIM_DOMAIN=
CAMPAIGN_DKIM_SELECTOR=
CAMPAIGN_DKIM_PRIVATE_KEY=
CAMPAIGN_DKIM_PRIVATE_KEY_FILE=
